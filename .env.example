# Copy to .env.local and fill in. Never commit real values.

# Supabase, used by the app (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: Google Sheets sync
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_ID=
SYNC_SECRET=
SYNC_PING_SECRET=
# Optional: db-wins (default) or sheet-wins
CONFLICT_POLICY=
